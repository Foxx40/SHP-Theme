<article class="page-track-order">
  <header class="page-hero">
    <div style="font-size: 2rem; margin-bottom: 6px;">📦</div>
    <h1 class="page-hero-title">Track Your Christmas Order</h1>
    <p class="page-hero-sub">Real-time international milestone tracking for parents and holiday shoppers.</p>
  </header>

  <div class="page-content-wrapper">
    <div class="track-order-card reveal-on-scroll">
      <form id="TrackOrderForm">
        <div class="track-form-group">
          <label for="TrackOrderNumber" class="track-label">Order Number (e.g., FB-88492)</label>
          <input 
            type="text" 
            id="TrackOrderNumber" 
            class="track-input" 
            placeholder="FB-XXXXX" 
            value="FB-88492" 
            required
          >
        </div>

        <div class="track-form-group">
          <label for="TrackEmail" class="track-label">Email or Phone Used at Checkout</label>
          <input 
            type="email" 
            id="TrackEmail" 
            class="track-input" 
            placeholder="parent@example.com" 
            value="shopper@example.com" 
            required
          >
        </div>

        <button type="submit" class="btn-tactile btn-primary" style="width: 100%; padding: 14px; margin-top: 8px;">
          <span>Track Order Status</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </form>

      <!-- Live Tracking Result Simulation -->
      <div id="TrackOrderResult" class="track-result-simulation">
        <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--color-border); padding-bottom: 10px;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 800;">Order Status</span>
            <div style="font-size: 1.15rem; font-weight: 900; color: var(--color-success);">⚡ In Transit &ndash; On Schedule</div>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 0.72rem; color: var(--color-text-muted);">Order #</span>
            <span id="TrackedOrderCode" style="font-weight: 800; font-family: var(--font-mono); color: var(--color-primary);">FB-88492</span>
          </div>
        </div>

        <div style="margin: 12px 0; font-size: 0.86rem; color: var(--color-text-main);">
          🎄 <strong>Estimated Delivery:</strong> December 21, 2026 (Guaranteed by Christmas)
        </div>

        <div class="track-timeline">
          <div class="timeline-step completed">
            <strong style="color: var(--color-text-main);">Package Dispatched via International Priority Air</strong>
            <div style="color: var(--color-text-muted); font-size: 0.74rem;">Customs Documentation cleared (DDP Pre-Paid)</div>
          </div>
          <div class="timeline-step completed">
            <strong style="color: var(--color-text-main);">Arrived at Regional Distribution Hub</strong>
            <div style="color: var(--color-text-muted); font-size: 0.74rem;">Processed through sort facility</div>
          </div>
          <div class="timeline-step">
            <strong style="color: var(--color-text-main);">Out for Local Doorstep Delivery</strong>
            <div style="color: var(--color-text-muted); font-size: 0.74rem;">Assigned to delivery route</div>
          </div>
          <div class="timeline-step">
            <strong style="color: var(--color-text-main);">Delivered to Recipient</strong>
            <div style="color: var(--color-text-muted); font-size: 0.74rem;">Ready to wrap for Christmas Day!</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
