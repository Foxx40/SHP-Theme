{%- style -%}
  #Hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }
  {%- if section.settings.custom_bg_color != blank -%}
    #Hero-{{ section.id }} {
      background-color: {{ section.settings.custom_bg_color }};
    }
  {%- endif -%}
  {%- if section.settings.custom_text_color != blank -%}
    #Hero-{{ section.id }} .hero-content,
    #Hero-{{ section.id }} .hero-headline,
    #Hero-{{ section.id }} .hero-subtext {
      color: {{ section.settings.custom_text_color }};
    }
  {%- endif -%}
  #Hero-{{ section.id }} .hero-parallax-bg {
    filter: brightness({{ section.settings.image_brightness | divided_by: 100.0 }});
  }
  #Hero-{{ section.id }} .hero-cta-group {
    --hero-button-height: {{ section.settings.button_min_height | default: 0 }}px;
  }
  #Hero-{{ section.id }} .hero-cta-group .btn-primary {
    {% if section.settings.primary_button_color != blank %}background-color: {{ section.settings.primary_button_color }};{% endif %}
    {% if section.settings.primary_button_text_color != blank %}color: {{ section.settings.primary_button_text_color }};{% endif %}
  }
  #Hero-{{ section.id }} .hero-cta-group .btn-outline {
    border-color: {{ section.settings.secondary_button_color | default: '#FFFFFF' }} !important;
    color: {{ section.settings.secondary_button_color | default: '#FFFFFF' }} !important;
  }
{%- endstyle -%}

<section class="hero-section" id="Hero-{{ section.id }}">
  <!-- 0.2x Speed Parallax Background Wrapper -->
  <div class="hero-parallax-wrapper">
    {%- assign hero_img_url = 'hero-winter-gadgets.jpg' | asset_url -%}
    {%- if section.settings.hero_image != blank -%}
      {%- assign hero_img_url = section.settings.hero_image | image_url: width: 2400 -%}
    {%- endif -%}

    <img 
      class="hero-parallax-bg" 
      src="{{ hero_img_url }}" 
      alt="{{ section.settings.headline | default: 'Cozy Winter Teen Gadget Room' | escape }}" 
      width="1440" 
      height="810" 
      loading="eager"
      fetchpriority="high"
    >
  </div>

  <!-- Gradient & Glow Overlay -->
  {%- if section.settings.show_gradient_overlay -%}
    <div class="hero-gradient-overlay" style="opacity: {{ section.settings.gradient_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <!-- Floating Snowflake Parallax Canvas -->
  {%- if section.settings.show_snowflakes -%}
    <div class="snowflakes-layer">
      <canvas class="snowflakes-canvas"></canvas>
    </div>
  {%- endif -%}

  <!-- Hero Content Container -->
  <div class="hero-content" style="text-align: {{ section.settings.content_alignment | default: 'center' }};">
    {%- if section.settings.urgency_tag != blank -%}
      <div class="hero-urgency-pill reveal-on-scroll">
        <span class="hero-urgency-dot"></span>
        <span>{{ section.settings.urgency_tag | escape }}</span>
      </div>
    {%- endif -%}

    <h1 class="hero-headline reveal-on-scroll delay-1 {{ section.settings.heading_size | default: 'h1' }}">
      {{ section.settings.headline | default: 'Trapped Indoors? Level Up Your Room & Beat Winter Boredom.' }}
    </h1>

    {%- if section.settings.subtext != blank -%}
      <div class="hero-subtext reveal-on-scroll delay-2">
        <p>{{ section.settings.subtext | escape }}</p>
      </div>
    {%- endif -%}

    <!-- Call to Actions -->
    <div class="hero-cta-group reveal-on-scroll delay-3">
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#trending' }}" class="btn-tactile btn-primary" {% if section.settings.open_primary_new_tab %}target="_blank" rel="noopener"{% endif %}>
          <span>{{ section.settings.btn_text | escape }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_btn_text != blank -%}
        <a href="{{ section.settings.secondary_btn_link | default: '#budget' }}" class="btn-tactile btn-outline" {% if section.settings.open_secondary_new_tab %}target="_blank" rel="noopener"{% endif %}>
          {{ section.settings.secondary_btn_text | escape }}
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'cta_button' and block.settings.label != blank -%}
          <a href="{{ block.settings.link | default: routes.root_url }}" class="btn-tactile {% if block.settings.style == 'outline' %}btn-outline{% else %}btn-primary{% endif %}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Reusable Reassurance Badges -->
    <div class="hero-badges-strip reveal-on-scroll delay-4">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'badge' -%}
              <div class="hero-badge-item" {{ block.shopify_attributes }}>
                <span>{{ block.settings.icon }}</span> {{ block.settings.text | escape }}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {%- else -%}
        <div class="hero-badge-item">
          <span>⚡</span> Free Express Worldwide Shipping
        </div>
        <div class="hero-badge-item">
          <span>🛡️</span> Zero Hidden Customs Fees (DDP)
        </div>
        <div class="hero-badge-item">
          <span>🔄</span> 60-Day Holiday Returns
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Parallax Hero Banner",
  "tag": "section",
  "class": "section section-hero-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero Media & Visual Effects"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "range",
      "id": "image_brightness",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Image Brightness",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "show_gradient_overlay",
      "label": "Show Contrast Gradient Overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 85
    },
    {
      "type": "checkbox",
      "id": "show_snowflakes",
      "label": "Show Drifting Snowflake Parallax Canvas",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography & Headings"
    },
    {
      "type": "text",
      "id": "urgency_tag",
      "label": "Urgency Pill Text",
      "default": "🎄 Order by Dec 15 for Christmas Arrival"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Hero Headline",
      "default": "Trapped Indoors? Level Up Your Room & Beat Winter Boredom."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Headline Size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra Large" }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Hero Subtext",
      "default": "The coolest gadgets and room tech for your Christmas Wishlist. Order by Dec 15 for guaranteed arrival."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Primary Button Text",
      "default": "Shop Winter Gadgets"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "checkbox",
      "id": "open_primary_new_tab",
      "label": "Open primary button link in a new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "🎁 Explore Gift Budgets"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "open_secondary_new_tab",
      "label": "Open secondary button link in a new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "button_min_height",
      "label": "Hero button minimum height",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "primary_button_color",
      "label": "Primary button background"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Primary button text"
    },
    {
      "type": "color",
      "id": "secondary_button_color",
      "label": "Secondary button border and text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Spacing & Colors"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "cta_button",
      "name": "Extra hero button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "badge",
      "name": "Reassurance Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji or Icon",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Free Express Worldwide Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parallax Hero Banner",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "⚡",
            "text": "Free Express Worldwide Shipping"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🛡️",
            "text": "Zero Hidden Customs Fees (DDP)"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🔄",
            "text": "60-Day Holiday Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
