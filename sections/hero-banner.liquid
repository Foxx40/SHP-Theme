<section class="hero-section" id="hero-{{ section.id }}">
  <!-- 0.2x Speed Parallax Background Wrapper -->
  <div class="hero-parallax-wrapper">
    {%- assign hero_img_url = 'hero-winter-gadgets.jpg' | asset_url -%}
    {%- if section.settings.hero_image != blank -%}
      {%- assign hero_img_url = section.settings.hero_image | image_url: width: 1800 -%}
    {%- endif -%}

    <img 
      class="hero-parallax-bg" 
      src="{{ hero_img_url }}" 
      alt="{{ section.settings.headline | default: 'Cozy Winter Teen Gadget Room' | escape }}" 
      width="1440" 
      height="810" 
      loading="eager"
      fetchpriority="high"
    >
  </div>

  <!-- Gradient & Glow Overlay -->
  <div class="hero-gradient-overlay"></div>

  <!-- Floating Snowflake Parallax Canvas -->
  {%- if section.settings.show_snowflakes -%}
    <div class="snowflakes-layer">
      <canvas class="snowflakes-canvas"></canvas>
    </div>
  {%- endif -%}

  <!-- Hero Content -->
  <div class="hero-content">
    {%- if section.settings.urgency_tag != blank -%}
      <div class="hero-urgency-pill reveal-on-scroll">
        <span class="hero-urgency-dot"></span>
        <span>{{ section.settings.urgency_tag | escape }}</span>
      </div>
    {%- endif -%}

    <h1 class="hero-headline reveal-on-scroll delay-1">
      {{ section.settings.headline | default: 'Trapped Indoors? Level Up Your Room & Beat Winter Boredom.' }}
    </h1>

    {%- if section.settings.subtext != blank -%}
      <p class="hero-subtext reveal-on-scroll delay-2">
        {{ section.settings.subtext | escape }}
      </p>
    {%- endif -%}

    <!-- Call to Actions -->
    <div class="hero-cta-group reveal-on-scroll delay-3">
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#trending' }}" class="btn-tactile btn-primary">
          <span>{{ section.settings.btn_text | escape }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_btn_text != blank -%}
        <a href="{{ section.settings.secondary_btn_link | default: '#budget' }}" class="btn-tactile btn-outline" style="border-color: rgba(255, 255, 255, 0.4); color: #FFFFFF;">
          {{ section.settings.secondary_btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

    <!-- Reusable Reassurance Badges -->
    <div class="hero-badges-strip reveal-on-scroll delay-4">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'badge' -%}
              <div class="hero-badge-item" {{ block.shopify_attributes }}>
                <span>{{ block.settings.icon }}</span> {{ block.settings.text | escape }}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {%- else -%}
        <div class="hero-badge-item">
          <span>⚡</span> Free Express Worldwide Shipping
        </div>
        <div class="hero-badge-item">
          <span>🛡️</span> Zero Hidden Customs Fees (DDP)
        </div>
        <div class="hero-badge-item">
          <span>🔄</span> 60-Day Holiday Returns
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Parallax Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "checkbox",
      "id": "show_snowflakes",
      "label": "Show Drifting Snowflake Parallax Canvas",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_tag",
      "label": "Urgency Pill Text",
      "default": "🎄 Order by Dec 15 for Christmas Arrival"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Hero Headline",
      "default": "Trapped Indoors? Level Up Your Room & Beat Winter Boredom."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Hero Subtext",
      "default": "The coolest gadgets and room tech for your Christmas Wishlist. Order by Dec 15 for guaranteed arrival."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Primary Button Text",
      "default": "Shop Winter Gadgets"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "🎁 Explore Gift Budgets"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Reassurance Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji or Icon",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Free Express Worldwide Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parallax Hero Banner",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "⚡",
            "text": "Free Express Worldwide Shipping"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🛡️",
            "text": "Zero Hidden Customs Fees (DDP)"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🔄",
            "text": "60-Day Holiday Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
