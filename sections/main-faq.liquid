{%- style -%}
  #Section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 36 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    {% if section.settings.custom_bg_color != blank %}
      background-color: {{ section.settings.custom_bg_color }};
    {% endif %}
  }
  #Section-{{ section.id }} .page-hero-title {
    {% if section.settings.custom_text_color != blank %}
      color: {{ section.settings.custom_text_color }};
    {% endif %}
  }
{%- endstyle -%}

<article class="page-faq" id="Section-{{ section.id }}">
  <header class="page-hero">
    {%- if section.settings.badge_emoji != blank -%}
      <div style="font-size: 2.2rem; margin-bottom: 8px;">{{ section.settings.badge_emoji }}</div>
    {%- endif -%}
    <h1 class="page-hero-title">{{ section.settings.heading | default: 'Holiday & Parent FAQ' | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="page-hero-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </header>

  <div class="page-content-wrapper">
    <div class="pdp-accordions" data-accordion-single>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="accordion-item{% if forloop.first and section.settings.open_first %} is-open{% endif %} reveal-on-scroll" {{ block.shopify_attributes }}>
            <button type="button" class="accordion-trigger">
              <div class="accordion-title-wrap">
                {%- if block.settings.emoji != blank -%}
                  <span>{{ block.settings.emoji }}</span>
                {%- endif -%}
                <span>{{ block.settings.question | escape }}</span>
              </div>
              <span class="accordion-icon-toggle">▼</span>
            </button>
            <div class="accordion-body"{% if forloop.first and section.settings.open_first %} style="max-height: 350px;"{% endif %}>
              <div class="rte" style="line-height: 1.6; color: var(--color-text-main);">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback FAQ Rows -->
        <div class="accordion-item is-open reveal-on-scroll">
          <button type="button" class="accordion-trigger">
            <div class="accordion-title-wrap">
              <span>🎄</span>
              <span>Will my order arrive before Christmas Day?</span>
            </div>
            <span class="accordion-icon-toggle">▼</span>
          </button>
          <div class="accordion-body" style="max-height: 250px;">
            <p><strong>Yes!</strong> All orders placed on or before our stated cutoff date (December 15–18 depending on destination country) are backed by our 100% Christmas Arrival Guarantee. If your package doesn't reach your address by December 24, we will refund your full shipping cost and send you a $25 gift card.</p>
          </div>
        </div>

        <div class="accordion-item reveal-on-scroll delay-1">
          <button type="button" class="accordion-trigger">
            <div class="accordion-title-wrap">
              <span>🔌</span>
              <span>Do these electronic gadgets work with UK / EU / AU / US power outlets?</span>
            </div>
            <span class="accordion-icon-toggle">▼</span>
          </button>
          <div class="accordion-body">
            <p><strong>Yes, universally compatible!</strong> 95% of our gadgets operate over universal USB-C or standard 5V USB power cables. For AC wall powered items (like the Levitating Orb Lamp), we automatically include a region-matched AC adapter based on your shipping address.</p>
          </div>
        </div>

        <div class="accordion-item reveal-on-scroll delay-2">
          <button type="button" class="accordion-trigger">
            <div class="accordion-title-wrap">
              <span>🛡️</span>
              <span>Are these gadgets safe for teens and tweens (ages 10–16)?</span>
            </div>
            <span class="accordion-icon-toggle">▼</span>
          </button>
          <div class="accordion-body">
            <p><strong>Strictly safety-tested:</strong> Every product in our catalog holds official CE, FCC, RoHS, and UKCA safety marks. We use shatter-resistant materials, non-toxic finishes, and low-voltage cool-to-touch LEDs.</p>
          </div>
        </div>

        <div class="accordion-item reveal-on-scroll delay-3">
          <button type="button" class="accordion-trigger">
            <div class="accordion-title-wrap">
              <span>💰</span>
              <span>Will the recipient or I have to pay any customs duty or VAT?</span>
            </div>
            <span class="accordion-icon-toggle">▼</span>
          </button>
          <div class="accordion-body">
            <p><strong>Zero surprise fees:</strong> We ship Delivered Duty Paid (DDP). All sales tax, VAT, and international import tariffs are settled upfront by us during dispatch. You and the recipient will never be asked for additional payment by the delivery courier.</p>
          </div>
        </div>

        <div class="accordion-item reveal-on-scroll delay-4">
          <button type="button" class="accordion-trigger">
            <div class="accordion-title-wrap">
              <span>🔄</span>
              <span>What if my teen receives duplicate gifts or wants a different color?</span>
            </div>
            <span class="accordion-icon-toggle">▼</span>
          </button>
          <div class="accordion-body">
            <p>Our extended holiday return window runs all the way through <strong>January 31, 2027</strong>. You or the gift recipient can initiate an exchange or return for any unopened item with free return drop-off available in 15+ countries.</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "FAQ & Help Accordions",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "badge_emoji",
      "label": "Header Emoji Icon",
      "default": "❓"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Holiday & Parent FAQ"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivery deadlines, international plug safety, and teen gadget certifications."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open First Question by Default",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Spacing & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Heading Color"
    }
  ],
  "blocks": [
    {
      "type": "faq_row",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Row Emoji Icon",
          "default": "🎄"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will my order arrive before Christmas Day?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p><strong>Yes!</strong> All orders placed on or before our stated cutoff date are backed by our 100% Christmas Arrival Guarantee.</p>"
        }
      ]
    }
  ],
  "presets": [
