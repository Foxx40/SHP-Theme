<header class="site-header" role="banner">
  <div class="header-container">
    <!-- Left: Hamburger Menu -->
    <div class="header-left">
      <button type="button" class="header-btn" data-drawer-trigger="nav" aria-label="Open Navigation Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Center: Brand Logo -->
    <div class="header-center">
      <a href="{{ routes.root_url }}" class="brand-logo" aria-label="{{ shop.name }}">
        <span class="logo-sparkle">❄️</span>
        <span>FROST<span class="logo-highlight">BYTE</span></span>
      </a>
    </div>

    <!-- Right: Search & Dynamic Cart -->
    <div class="header-right">
      <button type="button" class="header-btn" onclick="alert('Search: Enter gadget name or room aesthetic item');" aria-label="Search Catalog">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button type="button" class="header-btn cart-icon-btn" data-drawer-trigger="cart" aria-label="View Shopping Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-badge-count">1</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Navigation -->
<nav id="NavDrawer" class="nav-drawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true">
  <div class="drawer-header">
    <div class="drawer-title">
      <span>❄️</span>
      <span>HOLIDAY EXPLORER</span>
    </div>
    <button type="button" class="drawer-close-btn" data-drawer-close="nav" aria-label="Close navigation">
      ✕
    </button>
  </div>

  <div class="drawer-section-heading">Winter Boredom Categories</div>
  <ul class="drawer-nav-list">
    <li class="drawer-nav-item">
      <a href="#trending" class="drawer-nav-link highlight" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">🎮</span>Boredom Busters</span>
        <span class="drawer-nav-badge">HOT</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#trending" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">💡</span>Room Vibes & LED</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#trending" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">🕹️</span>Gaming & Desk Tech</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#trending" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">📸</span>Creative Tech & Vibe</span>
      </a>
    </li>
  </ul>

  <div class="drawer-section-heading">Holiday Gift Budgets</div>
  <ul class="drawer-nav-list">
    <li class="drawer-nav-item">
      <a href="#budget" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">🎄</span>Stocking Stuffers Under $25</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#budget" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">🎁</span>Under $50 Gadgets</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#budget" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">⭐</span>Under $100 Epic Tech</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="#budget" class="drawer-nav-link" data-drawer-close="nav">
        <span><span class="drawer-nav-icon">🔥</span>Top Christmas Wishlist</span>
      </a>
    </li>
  </ul>

  <div class="drawer-section-heading">Parent & International Help</div>
  <ul class="drawer-nav-list">
    <li class="drawer-nav-item">
      <a href="pages/track-order.html" class="drawer-nav-link">
        <span><span class="drawer-nav-icon">📦</span>Track My Order</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="pages/shipping-duties.html" class="drawer-nav-link">
        <span><span class="drawer-nav-icon">🌍</span>Shipping & Customs (DDP)</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="pages/returns.html" class="drawer-nav-link">
        <span><span class="drawer-nav-icon">🔄</span>60-Day Holiday Returns</span>
      </a>
    </li>
    <li class="drawer-nav-item">
      <a href="pages/faq.html" class="drawer-nav-link">
        <span><span class="drawer-nav-icon">❓</span>Holiday FAQ & Safety</span>
      </a>
    </li>
  </ul>

  <!-- Country & Currency Selector -->
  <div class="drawer-country-selector">
    <label class="drawer-country-label" for="drawer-country-select">Shipping Destination & Currency</label>
    <select id="drawer-country-select" class="country-currency-select drawer-country-select">
      <option value="USD">🇺🇸 United States (USD $)</option>
      <option value="GBP">🇬🇧 United Kingdom (GBP £)</option>
      <option value="EUR">🇪🇺 Europe / Eurozone (EUR €)</option>
      <option value="CAD">🇨🇦 Canada (CAD CA$)</option>
      <option value="AUD">🇦🇺 Australia (AUD AU$)</option>
    </select>
  </div>

  <div class="drawer-footer-reassurance">
    🎄 <strong>Guaranteed Christmas Delivery</strong><br>
    Orders ship with pre-paid import duties.
  </div>
</nav>

{% schema %}
{
  "name": "Header & Mobile Nav",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "FROSTBYTE"
    }
  ]
}
{% endschema %}
