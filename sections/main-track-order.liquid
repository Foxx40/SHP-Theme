{%- style -%}
  #Section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 36 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    {% if section.settings.custom_bg_color != blank %}
      background-color: {{ section.settings.custom_bg_color }};
    {% endif %}
  }
  #Section-{{ section.id }} .page-hero-title {
    {% if section.settings.custom_text_color != blank %}
      color: {{ section.settings.custom_text_color }};
    {% endif %}
  }
{%- endstyle -%}

<article class="page-track-order" id="Section-{{ section.id }}">
  <header class="page-hero">
    {%- if section.settings.badge_emoji != blank -%}
      <div style="font-size: 2.2rem; margin-bottom: 8px;">{{ section.settings.badge_emoji }}</div>
    {%- endif -%}
    <h1 class="page-hero-title">{{ section.settings.heading | default: 'Track Your Christmas Order' | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="page-hero-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </header>

  <div class="page-content-wrapper">
    <div class="track-order-card reveal-on-scroll">
      <form id="TrackOrderForm">
        <div class="track-form-group">
          <label for="TrackOrderNumber" class="track-label">{{ section.settings.order_number_label | default: 'Order Number (e.g., FB-88492)' }}</label>
          <input 
            type="text" 
            id="TrackOrderNumber" 
            class="track-input" 
            placeholder="FB-XXXXX" 
            value="FB-88492" 
            required
          >
        </div>

        <div class="track-form-group">
          <label for="TrackEmail" class="track-label">{{ section.settings.email_label | default: 'Email or Phone Used at Checkout' }}</label>
          <input 
            type="email" 
            id="TrackEmail" 
            class="track-input" 
            placeholder="parent@example.com" 
            value="shopper@example.com" 
            required
          >
        </div>

        <button type="submit" class="btn-tactile btn-primary" style="width: 100%; padding: 14px; margin-top: 8px;">
          <span>{{ section.settings.button_label | default: 'Track Order Status' }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </form>

      <!-- Live Tracking Result Simulation -->
      <div id="TrackOrderResult" class="track-result-simulation">
        <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--color-border); padding-bottom: 10px;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 800;">Order Status</span>
            <div style="font-size: 1.15rem; font-weight: 900; color: var(--color-success);">⚡ {{ section.settings.status_badge | default: 'In Transit – On Schedule' }}</div>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 0.72rem; color: var(--color-text-muted);">Order #</span>
            <span id="TrackedOrderCode" style="font-weight: 800; font-family: var(--font-mono); color: var(--color-primary);">FB-88492</span>
          </div>
        </div>

        <div style="margin: 12px 0; font-size: 0.86rem; color: var(--color-text-main);">
          🎄 <strong>Estimated Delivery:</strong> {{ section.settings.estimated_delivery | default: 'December 21, 2026 (Guaranteed by Christmas)' }}
        </div>

        <div class="track-timeline">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="timeline-step{% if block.settings.is_completed %} completed{% endif %}" {{ block.shopify_attributes }}>
                <strong style="color: var(--color-text-main);">{{ block.settings.title }}</strong>
                <div style="color: var(--color-text-muted); font-size: 0.74rem;">{{ block.settings.detail }}</div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="timeline-step completed">
              <strong style="color: var(--color-text-main);">Package Dispatched via International Priority Air</strong>
              <div style="color: var(--color-text-muted); font-size: 0.74rem;">Customs Documentation cleared (DDP Pre-Paid)</div>
            </div>
            <div class="timeline-step completed">
              <strong style="color: var(--color-text-main);">Arrived at Regional Distribution Hub</strong>
              <div style="color: var(--color-text-muted); font-size: 0.74rem;">Processed through sort facility</div>
            </div>
            <div class="timeline-step">
              <strong style="color: var(--color-text-main);">Out for Local Doorstep Delivery</strong>
              <div style="color: var(--color-text-muted); font-size: 0.74rem;">Assigned to delivery route</div>
            </div>
            <div class="timeline-step">
              <strong style="color: var(--color-text-main);">Delivered to Recipient</strong>
              <div style="color: var(--color-text-muted); font-size: 0.74rem;">Ready to wrap for Christmas Day!</div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Order Tracking",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "badge_emoji",
      "label": "Header Emoji Icon",
      "default": "📦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track Your Christmas Order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real-time international milestone tracking for parents and holiday shoppers."
    },
    {
      "type": "header",
      "content": "Form Labels"
    },
    {
      "type": "text",
      "id": "order_number_label",
      "label": "Order Number Label",
      "default": "Order Number (e.g., FB-88492)"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email / Phone Label",
      "default": "Email or Phone Used at Checkout"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Track Button Label",
      "default": "Track Order Status"
    },
    {
      "type": "header",
      "content": "Status Simulation Defaults"
    },
    {
      "type": "text",
      "id": "status_badge",
      "label": "Status Text",
      "default": "In Transit – On Schedule"
    },
    {
      "type": "text",
      "id": "estimated_delivery",
      "label": "Estimated Delivery Text",
      "default": "December 21, 2026 (Guaranteed by Christmas)"
    },
    {
      "type": "header",
      "content": "Section Spacing & Colors"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Heading Color"
    }
  ],
  "blocks": [
    {
      "type": "timeline_step",
      "name": "Timeline Milestone",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Package Dispatched via International Priority Air"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Step Subtext",
          "default": "Customs Documentation cleared (DDP Pre-Paid)"
        },
        {
          "type": "checkbox",
          "id": "is_completed",
          "label": "Mark as Completed",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Track Order",
      "blocks": [
        {
          "type": "timeline_step",
          "settings": {
            "title": "Package Dispatched via International Priority Air",
            "detail": "Customs Documentation cleared (DDP Pre-Paid)",
            "is_completed": true
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Arrived at Regional Distribution Hub",
            "detail": "Processed through sort facility",
            "is_completed": true
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Out for Local Doorstep Delivery",
            "detail": "Assigned to delivery courier route",
            "is_completed": false
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Delivered to Recipient",
            "detail": "Ready to wrap for Christmas Day!",
            "is_completed": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
