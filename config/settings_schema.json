[
  {
    "name": "Theme information",
    "theme_name": "Frostbyte - Winter Gadget Store",
    "theme_version": "1.0.0",
    "theme_author": "Antigravity Engineering",
    "theme_documentation_url": "https://frostbyte-gadgets.com/docs",
    "theme_support_url": "https://frostbyte-gadgets.com/support"
  },
  {
    "name": "Color Scheme & Tokens",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent (Frosted Cranberry)",
        "default": "#9B1B30",
        "info": "Primary CTAs, Add to Cart, notification banner, sale badges"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Accent (Frost Blue)",
        "default": "#2B4C5E",
        "info": "Active states, filter tags, subheadings, accordion toggles"
      },
      {
        "type": "color",
        "id": "color_canvas",
        "label": "Canvas Background (Winter Snow)",
        "default": "#F8F9FA",
        "info": "Clean off-white page background"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card / Surface Container (Soft Slate)",
        "default": "#E9ECEF",
        "info": "Product cards, drawer backgrounds, input fields, review tiles"
      },
      {
        "type": "color",
        "id": "color_text_main",
        "label": "Text & Headings (Deep Navy Grey)",
        "default": "#1E293B",
        "info": "Body text and crisp headings"
      },
      {
        "type": "range",
        "id": "content_max_width",
        "label": "Maximum content width",
        "min": 960,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "range",
        "id": "radius_small",
        "label": "Small corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "radius_medium",
        "label": "Medium corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "radius_large",
        "label": "Large corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button shape",
        "options": [
          { "value": "pill", "label": "Pill" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "square", "label": "Slightly rounded" }
        ],
        "default": "pill"
      },
      {
        "type": "range",
        "id": "button_primary_vertical_padding",
        "label": "Primary button height",
        "min": 8,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "button_primary_horizontal_padding",
        "label": "Primary button width padding",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "button_font_size",
        "label": "Button text size",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Christmas Shipping & Delivery",
    "settings": [
      {
        "type": "text",
        "id": "cutoff_date",
        "label": "Order Cutoff Date",
        "default": "Dec 15"
      },
      {
        "type": "checkbox",
        "id": "enable_snow_effect",
        "label": "Enable subtle drifting snowflake parallax layer",
        "default": true
      }
    ]
  }
]
